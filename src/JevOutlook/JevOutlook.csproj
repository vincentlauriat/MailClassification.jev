<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>jevoutlook</AssemblyName>
    <RootNamespace>JevOutlook</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RollForward>Major</RollForward>
    <Version>0.1.0</Version>
    <Description>AI-assisted Outlook classification with Jev (TypeSafe) via OpenRouter and Microsoft Graph.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JevOutlook.Tests" />
  </ItemGroup>

</Project>
